        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    LOCATIONS {\n        int LocationId PK\n        varchar LocationName UK\n    }\n\n    OFFICES {\n        int OfficeId PK\n        int LocationId FK\n        varchar OfficeName\n    }\n\n    MODULES {\n        int ModuleId PK\n        int OfficeId FK\n        varchar ModuleName UK\n    }\n\n    ROLES {\n        int RoleId PK\n        varchar RoleName UK\n    }\n\n    EMPLOYEES {\n        int EmployeeId PK\n        int RoleId FK\n        varchar EmployeeName\n        varchar Email UK\n        varchar PasswordHash\n        boolean IsActive\n    }\n\n    ROOMTYPES {\n        int RoomTypeId PK\n        varchar TypeName UK\n    }\n\n    ROOMS {\n        varchar RoomNumber PK\n        int RoomTypeId FK\n        int ModuleId FK\n        varchar RoomName\n        int Capacity\n        varchar Status\n    }\n\n    FACILITIES {\n        int FacilityId PK\n        varchar FacilityName UK\n    }\n\n    ROOMFACILITIES {\n        varchar RoomNumber PK, FK\n        int FacilityId PK, FK\n    }\n\n    SEATS {\n        int SeatId PK\n        int ModuleId FK\n        varchar SeatNumber\n        int RowNumber\n        int ColumnNumber\n        boolean IsActive\n    }\n\n    BOOKINGS {\n        int BookingId PK\n        varchar RoomNumber FK\n        int EmployeeId FK\n        varchar MeetingTitle\n        int ParticipantCount\n        date BookingDate\n        time StartTime\n        time EndTime\n        timestamptz BookedOn\n        varchar Status\n    }\n\n    HOTSEATBOOKINGS {\n        int HotseatBookingId PK\n        int SeatId FK\n        int EmployeeId FK\n        date BookingDate\n        varchar BookingStatus\n        timestamptz BookedOn\n        timestamptz CheckInDeadline\n        timestamptz CheckInTime\n        timestamptz ReleasedOn\n    }\n\n    NOTIFICATIONS {\n        int NotificationId PK\n        int EmployeeId FK\n        int BookingId FK\n        int HotseatBookingId FK\n        varchar Message\n        boolean IsRead\n        timestamptz CreatedAt\n    }\n\n\n    %% LOCATION HIERARCHY\n\n    LOCATIONS ||--o{ OFFICES : contains\n    OFFICES ||--o{ MODULES : contains\n\n\n    %% MODULE RESOURCES\n\n    MODULES ||--o{ ROOMS : contains\n    MODULES ||--o{ SEATS : contains\n\n\n    %% ROOM MANAGEMENT\n\n    ROOMTYPES ||--o{ ROOMS : categorizes\n\n    ROOMS ||--o{ ROOMFACILITIES : has\n    FACILITIES ||--o{ ROOMFACILITIES : assigned_to\n\n\n    %% EMPLOYEE AND ROLE\n\n    ROLES ||--o{ EMPLOYEES : assigned_to\n\n\n    %% ROOM BOOKING\n\n    EMPLOYEES ||--o{ BOOKINGS : creates\n    ROOMS ||--o{ BOOKINGS : reserved\n\n\n    %% HOTSEAT BOOKING\n\n    EMPLOYEES ||--o{ HOTSEATBOOKINGS : creates\n    SEATS ||--o{ HOTSEATBOOKINGS : reserved\n\n\n    %% NOTIFICATIONS\n\n    EMPLOYEES ||--o{ NOTIFICATIONS : receives\n    BOOKINGS ||--o{ NOTIFICATIONS : generates\n    HOTSEATBOOKINGS ||--o{ NOTIFICATIONS : generates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CLMzsVBTHca8FjkV6qj6-1">
